---
# For configuration options and examples, please see:
# https://gethomepage.dev/configs/services/

- Infraestructura y red:
    - Infraestructura:
        - Proxmox:
            icon: sh-proxmox
            href: https://${DOMAIN_PVE}
            description: Proxmox Virtualization Platform
            widget:
              type: proxmox
              url: https://${DOMAIN_PVE}
              username: ${PROXMOX_NODE_USERNAME}
              password: ${PROXMOX_NODE_PASSWORD}
              node: ${PROXMOX_NODE_NAME}

        - ProxMenux:
            icon: sh-proxmenux
            href: https://${DOMAIN_PROXMENUX}
            description: Otro PVE monitor

        - Home Assistant:
            icon: si-homeassistant
            href: https://${DOMAIN_HOMEASSISTANT}
            description: Domótica y automatización
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 117
            proxmoxType: qemu
            widget:
              type: homeassistant
              url: https://${DOMAIN_HOMEASSISTANT}
              key: ${HOMEASSISTANT_KEY}

    - Red:
        - AdGuard:
            icon: si-adguard
            href: https://${DOMAIN_ADGUARD}
            description: DNS and ad-blocker
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 101
            proxmoxType: lxc
            widget:
              type: adguard
              url: https://${DOMAIN_ADGUARD}
              username: alpargatagazer
              password: ${ADGUARD_PASSWORD}

        - Cloudflare Tunnel:
            icon: sh-cloudflare
            href: https://dash.cloudflare.com/
            description: Ramper web túnel
            widget:
              type: cloudflared
              accountid: ${CLOUDFLARE_ACCOUNT_ID}
              tunnelid: ${CLOUDFLARE_TUNNEL_ID}
              key: ${CLOUDFLARE_TUNNEL_KEY}

        - Tailscale:
            icon: sh-tailscale
            href: https://login.tailscale.com/
            description: AdGuard en Tailscale
            widget:
              type: tailscale
              deviceid: ${TAILSCALE_DEVICE_ID}
              key: ${TAILSCALE_KEY}
              fields: ["address", "update_available", "last_seen"]

- Almacenamiento y Archivos:
    - Filebrowser Quantum:
        icon: sh-filebrowser-quantum
        href: https://${DOMAIN_FILEBROWSER}
        description: Navegador de archivos y compartidor de carpetas
        proxmoxNode: ${PROXMOX_NODE_NAME}
        proxmoxVMID: 109
        proxmoxType: lxc

    - Syncthing:
        icon: sh-syncthing
        href: https://${DOMAIN_SYNCTHING}
        description: Sincroniza carpetas en distintos dispositivos
        proxmoxNode: ${PROXMOX_NODE_NAME}
        proxmoxVMID: 110
        proxmoxType: lxc

- Aplicaciones y Servicios:
    - app1:
        - FreshRSS:
            icon: sh-freshrss
            href: https://${DOMAIN_FRESHRSS}
            description: Lector y agregador RSS
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 103
            proxmoxType: lxc
            widget:
              type: freshrss
              url: https://${DOMAIN_FRESHRSS}
              username: alpargatagazer
              password: ${FRESHRSS_PASSWORD}

        - BentoPDF:
            icon: sh-bentopdf
            href: https://${DOMAIN_BENTO}
            description: Herramientas para PDF
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 105
            proxmoxType: lxc

        - Vaultwarden:
            icon: sh-vaultwarden
            href: https://${DOMAIN_VAULT}
            description: Gestor de contraseñas
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 113
            proxmoxType: lxc

        - MeTube:
            icon: sh-metube
            href: https://${DOMAIN_METUBE}
            description: Descargas de YouTube
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 116
            proxmoxType: lxc

    - app2:
        - Navidrome:
            icon: sh-navidrome
            href: https://${DOMAIN_NAVIDROME}
            description: Plataforma de streaming musical
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 112
            proxmoxType: lxc
            widget:
              type: navidrome
              url: https://${DOMAIN_NAVIDROME}
              user: ${NAVIDROME_USER}
              token: ${NAVIDROME_TOKEN}
              salt: randomsalt

        - Ramper web:
            icon: sh-caddy
            href: https://${DOMAIN_RAMPER}
            description: Ramper web hosting
            proxmoxNode: ${PROXMOX_NODE_NAME}
            proxmoxVMID: 107
            proxmoxType: lxc
            widgets:
              - type: uptimekuma
                url: https://${DOMAIN_RAMPER_STATUS}/
                slug: ramper-local
              - type: uptimekuma
                url: https://${DOMAIN_RAMPER_STATUS}/
                slug: ramper-online
